        if len(right) == 21:
            for idx, row in enumerate(right.itertuples()):
                landmarks[63+idx*3] = row.x if not np.isnan(row.x) else 0.0
                landmarks[63+idx*3+1] = row.y if not np.isnan(row.y) else 0.0
                landmarks[63+idx*3+2] = row.z if not np.isnan(row.z) else 0.0
        if np.count_nonzero(landmarks) > 0:
            class_landmarks.append(landmarks)
    if class_landmarks:
        reference_landmarks[cls] = np.mean(class_landmarks, axis=0).tolist()

with open('/kaggle/working/reference_landmarks.json', 'w') as f:
    json.dump(reference_landmarks, f)

print("Reference landmarks saved for", len(reference_landmarks), "classes")
for cls in reference_landmarks:
    arr = np.array(reference_landmarks[cls])
    print(f"{cls}: {np.count_nonzero(arr)} non-zero values")





