indices = np.random.choice(len(X_mlp_test), 10, replace=False)

correct = 0
for idx in indices:
    sample = X_mlp_test[idx:idx+1]
    true_label = final_selected[y_mlp_true_classes[idx]]
    pred_probs = best_mlp.predict(sample, verbose=0)
    pred_idx = np.argmax(pred_probs)
    pred_label = final_selected[pred_idx]
    confidence = pred_probs[0][pred_idx] * 100
    status = "✓" if pred_label == true_label else "✗"
    if pred_label == true_label:
        correct += 1
    print(f"{status} True: {true_label:<15} Predicted: {pred_label:<15} Confidence: {confidence:.1f}%")

print(f"\nCorrect: {correct}/10")





